{
  "name": "Calculator",
  "short_name": "Calculator",
  "description": "A fast, modern calculator with scientific mode, history and offline support.",
  "start_url": "cal.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b0c12",
